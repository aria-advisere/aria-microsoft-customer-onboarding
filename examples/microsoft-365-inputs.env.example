# Microsoft 365 delegated integration input worksheet
# Fill these values before running ./scripts/provision-clim365-app.sh.
# Do not store passwords, access tokens, refresh tokens, or MFA material here.

MICROSOFT_TENANT_ID="00000000-0000-0000-0000-000000000000"
INTEGRATION_USER_UPN="aria.integration@example.com"
APP_DISPLAY_NAME="ARIA - Example - Microsoft 365 Integration"
OUTPUT_DIR="./aria-example-microsoft"

# Enable only the workloads approved for this customer.
# Use --enable-all for all workloads, or combine --disable-* flags to reduce scope.
ENABLE_OUTLOOK="true"
ENABLE_CALENDAR="true"
ENABLE_SHAREPOINT="true"
ENABLE_DRIVE="false"

# Required only when SharePoint is enabled.
SHAREPOINT_SITE_URL="https://example.sharepoint.com/sites/ARIA"
SHAREPOINT_FOLDER_URL="Shared Documents/ARIA"

# Optional. Use only when updating an existing App Registration.
EXISTING_APP_ID=""

# Optional. Set to true if the customer wants the script to configure
# permissions but not grant tenant-wide admin consent.
SKIP_ADMIN_CONSENT="false"

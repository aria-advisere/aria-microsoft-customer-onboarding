# Microsoft Teams channel input worksheet
# Fill these values before running ./scripts/provision-aria-msteams-bot.sh.
# The Teams channel is optional and independent from Microsoft 365 delegated integration.

MICROSOFT_TENANT_ID="00000000-0000-0000-0000-000000000000"
CUSTOMER_SLUG="example"
ARIA_STAGE="staging"
ARIA_TENANT_ID="example"
MESSAGING_ENDPOINT="https://example.execute-api.us-east-1.amazonaws.com/teams/example/api/messages"

TEAMS_APP_NAME="ARIA Example"
DEVELOPER_NAME="ARIA"
WEBSITE_URL="https://example.com"
PRIVACY_URL="https://example.com/privacy"
TERMS_URL="https://example.com/terms"
OUTPUT_DIR="./aria-example-microsoft"

# Optional branding files.
COLOR_ICON_PATH=""
OUTLINE_ICON_PATH=""

# Generated by the script. Send only through the approved secret channel.
GENERATED_SECRET_FILE="aria-msteams-secret.json"
